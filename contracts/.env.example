# Foundry deployment configuration
# Copy to .env and load it in your shell. Never commit the real .env file.

# Select the deployment RPC: arc mainnet or arc testnet
DEPLOY_RPC_URL=https://rpc.mainnet.arc.io

# Deployer private key.
# NOTE: this Foundry version REQUIRES the 0x prefix here, despite the common
# convention. A bare hex key fails with "missing hex prefix (\"0x\")".
# Gas on Arc is paid in USDC, not ETH — fund this wallet with USDC first.
PRIVATE_KEY=0xyour_deployer_private_key

# Arc mainnet or testnet ERC-20 USDC interface (same address on both)
USDC_ADDRESS=0x3600000000000000000000000000000000000000

# Treasury receiving the 3% interest fee
TREASURY=0x0000000000000000000000000000000000000000

# Optional: set this when using a block explorer verification command
ARC_EXPLORER_API_KEY=your_arc_explorer_api_key

# Optional: chama name, 1-64 UTF-8 bytes. Defaults to "Default Chama".
# CHAMA_NAME=Default Chama
