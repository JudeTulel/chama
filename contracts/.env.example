# Foundry deployment configuration
# Copy to .env and load it in your shell. Never commit the real .env file.

# Select the deployment RPC: arc mainnet or arc testnet
DEPLOY_RPC_URL=https://rpc.testnet.arc.io

# Deployer private key, without the 0x prefix is accepted by Foundry
PRIVATE_KEY=your_deployer_private_key

# Arc mainnet or testnet ERC-20 USDC interface
USDC_ADDRESS=0x3600000000000000000000000000000000000000

# Treasury receiving the 10% interest fee
TREASURY=0x0000000000000000000000000000000000000000

# Optional: set this when using a block explorer verification command
ARC_EXPLORER_API_KEY=your_arc_explorer_api_key
